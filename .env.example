# Cherry Was Here - Environment Configuration

# Development
NODE_ENV=development
VITE_APP_NAME=Cherry Was Here
VITE_APP_VERSION=1.0.0

# Map Configuration
VITE_MAP_DEFAULT_ZOOM=1
VITE_MAP_MAX_ZOOM=8
VITE_MAP_MIN_ZOOM=1

# Default Colors
VITE_DEFAULT_VISITED_COLOR=#10B981
VITE_DEFAULT_UNVISITED_COLOR=#6B7280
VITE_DEFAULT_SELECTED_COLOR=#3B82F6
VITE_DEFAULT_HOVER_COLOR=#F59E0B

# Feature Flags
VITE_ENABLE_PROVINCES=false
VITE_ENABLE_PHOTO_UPLOAD=false
VITE_ENABLE_EXPORT=true
VITE_ENABLE_SHARING=false
